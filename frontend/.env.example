# Copy to .env.local (git-ignored) and adjust as needed.
#
# Empty means the frontend calls the API on its own origin. That is what the
# Vite dev proxy expects, and what a reverse proxy that serves the built
# frontend and forwards /api to the backend expects.
#
# Set an absolute origin when the backend is deployed somewhere else:
#   VITE_API_BASE_URL=https://url-check-api.example.com
VITE_API_BASE_URL=
